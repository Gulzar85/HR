# Copy to .env (never commit .env). Safe placeholder values only.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://ems_user:change-me@localhost:5432/mcd_ems
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=ems@example.invalid
# Storage: local filesystem by default
MEDIA_ROOT=media
# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Identity & security (Phase 1) ---
EMS_MAX_FAILED_LOGINS=5
EMS_LOCKOUT_MINUTES=15
EMS_ADMIN_PAGE_SIZE=25
EMS_TRUSTED_PROXY_COUNT=0
# Public base URL used in e-mails created outside a request (e.g. https://ems.example.com)
EMS_SITE_URL=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Production e-mail, e.g. smtp+tls://user:password@smtp.example.com:587
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
